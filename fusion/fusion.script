go.property("factory", msg.url())
go.property("remote_object", false)
go.property("is_scene_object", false)

go.property("ownermode_transaction", false)
go.property("ownermode_dynamic", false)
go.property("ownermode_masterclient", true)

go.property("settings_none", true)
go.property("settings_owner_leaves_owner_to_none", false)
go.property("settings_global_instance", false)

go.property("interestmode_all", true)
go.property("interestmode_area", false)
go.property("interestmode_assigned", false)


function init(self)
	print("init", go.get_id(), self.remote_object, os.date())
	assert(go.exists(self.factory))
	if not self.remote_object then
		msg.post("#", "register_object")
	end
end

function final(self)
	print("final", go.get_id())
	if not self.remote_object then
		fusion.destroy(go.get_id())
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("register_object") then
		print("on_message register_object", go.get_id())
		local scene = 0

		local owner_mode = fusion.OWNERMODE_MASTERCLIENT
		if self.ownermode_transaction  then owner_mode = fusion.OWNERMODE_TRANSACTION end
		if self.ownermode_dynamic      then owner_mode = fusion.OWNERMODE_DYNAMIC end
		if self.ownermode_masterclient then owner_mode = fusion.OWNERMODE_MASTERCLIENT end

		if self.is_scene_object then
			print("calling fusion.register_scene_object()", go.get_id())
			fusion.register_scene_object(go.get_id(), scene, self.factory, options)
		else
			print("calling fusion.register_object()", go.get_id())
			fusion.register_object(go.get_id(), scene, self.factory, owner_mode)
		end
		
	end
end