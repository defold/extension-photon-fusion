- name: fusion
  type: table
  desc: Functions and constants for interacting with Photon Fusion

  members:
  - name: init
    type: function
    desc: |
      Initialize Fusion.
    parameters:
    - name: app_id
      type: string
    - name: app_version
      type: string

  - name: connect
    type: function
    desc: |
      Connect Fusion.
    parameters:
    - name: region
      type: string
    - name: user
      type: string
    - name: server
      type: string

  - name: disconnect
    type: function
    desc: |
      Disonnect Fusion.

  - name: reconnect
    type: function
    desc: |
      Reconnect Fusion.

  - name: start
    type: function
    desc: |
      Start Fusion sync.

  - name: stop
    type: function
    desc: |
      Stop Fusion sync.

  - name: get_state
    type: function
    desc: |
      Get connection state.
    returns:
    - name: Connection
      type: number
      desc: |
        State
        

  - name: get_disconnect_cause
    type: function
    desc: |
      Get disconnect cause.
    returns:
    - name: Disconnect
      type: number
      desc: |
        Cause
        

  - name: join_or_create_room_random
    type: function
    desc: |
      Join or create random room.
    parameters:
    - name: room_name
      type: string

  - name: join_room
    type: function
    desc: |
      Join room.
    parameters:
    - name: room_name
      type: string

  - name: is_connected
    type: function
    desc: |
      Check if Fusion connected.
    returns:
    - name: connected
      type: boolean

  - name: is_running
    type: function
    desc: |
      Check if Fusion is running.
    returns:
    - name: running
      type: boolean

  - name: is_in_room
    type: function
    desc: |
      Check if Fusion is in a room.
    returns:
    - name: in_room
      type: boolean

  - name: enable_debugging
    type: function
    desc: |
      Enable/disable debugging.
    parameters:
    - name: enable
      type: boolean

  - name: register
    type: function
    desc: |
      Register a scene object.
    parameters:
    - name: id
      type: string
    - name: scene
      type: number

  - name: register
    type: function
    desc: |
      Register an object.
    parameters:
    - name: id
      type: string
    - name: scene
      type: number

  - name: destroy
    type: function
    desc: |
      Destroy a local object.
    parameters:
    - name: id
      type: string

  - name: scene_change
    type: function
    desc: |
      Change scene.
    parameters:
    - name: index
      type: number
    - name: sequence
      type: number
    - name: data
      type: string

  - name: send_rpc
    type: function
    desc: |
      Send RPC.
    parameters:
    - name: target_player
      type: number
      desc: |
        0 = all, specific PlayerId = targeted
        
    - name: data
      type: string
    returns:
    - name: ok
      type: boolean

  - name: on_event
    type: function
    desc: |
      Set event listener.
    parameters:
    - name: listener
      type: function

  - name: get_local_player_id
    type: function
    desc: |
      Get the player id of the local client
    returns:
    - name: The
      type: number
      desc: |
        Player id of the local client
        

  - name: get_owner
    type: function
    desc: |
      Get the player id of the current owner of an object
    parameters:
    - name: id
      type: string
      desc: |
        Id of the object to get the owner for
        
    returns:
    - name: The
      type: number
      desc: |
        Player id of the object's owner
        

  - name: is_owner
    type: function
    desc: |
      Check if the local client is the owner of an object
    parameters:
    - name: id
      type: string
      desc: |
        Id of the object
        
    returns:
    - name: True
      type: boolean
      desc: |
        If the local client is the owner of the object
        

  - name: has_owner
    type: function
    desc: |
      Check if an object has an owner
    parameters:
    - name: id
      type: string
      desc: |
        Id of the object
        
    returns:
    - name: True
      type: boolean
      desc: |
        If the object has an owner
        

  - name: set_want_owner
    type: function
    desc: |
      Signal desire for the local client to own an object
    parameters:
    - name: id
      type: string
      desc: |
        Id of the object to own
        

  - name: set_dont_want_owner
    type: function
    desc: |
      Signal desire for the local client to no longer own an object
    parameters:
    - name: id
      type: string
      desc: |
        Id of the object to disown
        

  - name: clear_owner_cooldown
    type: function
    desc: |
      Explicitly clear the ownership cooldown
    parameters:
    - name: id
      type: string
      desc: |
        Id of the object to clear cooldown for
        

  - name: player_count
    type: function
    desc: |
      Get player count
    returns:
    - name: count
      type: number
      desc: |
        Number of players
        

  - name: is_master_client
    type: function
    desc: |
      Get if this client is the room's master
    returns:
    - name: master
      type: boolean
      desc: |
        True if this client is the room's master
        

  - name: get_rtt
    type: function
    desc: |
      Get round trip time
    returns:
    - name: rtt
      type: number
      desc: |
        Round trip time in seconds
        

  - name: network_time_diff
    type: function
    desc: |
      Get raw offset between server time and local time. A positive value means the server clock is ahead of the local clock.
    returns:
    - name: diff
      type: number
      desc: |
        Time diff
        

  - name: area_of_interest_used
    type: function
    desc: |
      Check if the room has AOI enabled..
    returns:
    - name: aoi_used
      type: boolean
      desc: |
        True if the room/session has AOI enabled
        

  - name: area_of_interest_cell_size
    type: function
    desc: |
      Get the AOI cell size. Configured on a room level.
    returns:
    - name: size
      type: number
      desc: |
        The cell size, uniform across all three axis.
        

  - name: OWNERMODE_TRANSACTION
    type: number
    desc: |
      OWNERMODE_TRANSACTION

  - name: OWNERMODE_DYNAMIC
    type: number
    desc: |
      OWNERMODE_DYNAMIC

  - name: OWNERMODE_MASTERCLIENT
    type: number
    desc: |
      OWNERMODE_MASTERCLIENT

  - name: STATE_DISCONNECTED
    type: number
    desc: |
      STATE_DISCONNECTED

  - name: STATE_CONNECTING
    type: number
    desc: |
      STATE_CONNECTING

  - name: STATE_CONNECTED
    type: number
    desc: |
      STATE_CONNECTED

  - name: STATE_JOININGROOM
    type: number
    desc: |
      STATE_JOININGROOM

  - name: STATE_INROOM
    type: number
    desc: |
      STATE_INROOM

  - name: STATE_LEAVINGROOM
    type: number
    desc: |
      STATE_LEAVINGROOM

  - name: STATE_DISCONNECTING
    type: number
    desc: |
      STATE_DISCONNECTING

  - name: DISCONNECT_CAUSE_NONE
    type: number
    desc: |
      DISCONNECT_CAUSE_NONE

  - name: DISCONNECT_CAUSE_DISCONNECTBYSERVERUSERLIMIT
    type: number
    desc: |
      DISCONNECT_CAUSE_DISCONNECTBYSERVERUSERLIMIT

  - name: DISCONNECT_CAUSE_EXCEPTIONONCONNECT
    type: number
    desc: |
      DISCONNECT_CAUSE_EXCEPTIONONCONNECT

  - name: DISCONNECT_CAUSE_DISCONNECTBYSERVER
    type: number
    desc: |
      DISCONNECT_CAUSE_DISCONNECTBYSERVER

  - name: DISCONNECT_CAUSE_DISCONNECTBYSERVERLOGIC
    type: number
    desc: |
      DISCONNECT_CAUSE_DISCONNECTBYSERVERLOGIC

  - name: DISCONNECT_CAUSE_TIMEOUTDISCONNECT
    type: number
    desc: |
      DISCONNECT_CAUSE_TIMEOUTDISCONNECT

  - name: DISCONNECT_CAUSE_EXCEPTION
    type: number
    desc: |
      DISCONNECT_CAUSE_EXCEPTION

  - name: DISCONNECT_CAUSE_INVALIDAUTHENTICATION
    type: number
    desc: |
      DISCONNECT_CAUSE_INVALIDAUTHENTICATION

  - name: DISCONNECT_CAUSE_MAXCCUREACHED
    type: number
    desc: |
      DISCONNECT_CAUSE_MAXCCUREACHED

  - name: DISCONNECT_CAUSE_INVALIDREGION
    type: number
    desc: |
      DISCONNECT_CAUSE_INVALIDREGION

  - name: DISCONNECT_CAUSE_OPERATIONNOTALLOWEDINCURRENTSTATE
    type: number
    desc: |
      DISCONNECT_CAUSE_OPERATIONNOTALLOWEDINCURRENTSTATE

  - name: DISCONNECT_CAUSE_CUSTOMAUTHENTICATIONFAILED
    type: number
    desc: |
      DISCONNECT_CAUSE_CUSTOMAUTHENTICATIONFAILED

  - name: DISCONNECT_CAUSE_CLIENTVERSIONTOOOLD
    type: number
    desc: |
      DISCONNECT_CAUSE_CLIENTVERSIONTOOOLD

  - name: DISCONNECT_CAUSE_CLIENTVERSIONINVALID
    type: number
    desc: |
      DISCONNECT_CAUSE_CLIENTVERSIONINVALID

  - name: DISCONNECT_CAUSE_DASHBOARDVERSIONINVALID
    type: number
    desc: |
      DISCONNECT_CAUSE_DASHBOARDVERSIONINVALID

  - name: DISCONNECT_CAUSE_AUTHENTICATIONTICKETEXPIRED
    type: number
    desc: |
      DISCONNECT_CAUSE_AUTHENTICATIONTICKETEXPIRED

  - name: DISCONNECT_CAUSE_DISCONNECTBYOPERATIONLIMIT
    type: number
    desc: |
      DISCONNECT_CAUSE_DISCONNECTBYOPERATIONLIMIT
