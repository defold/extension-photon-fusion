- name: fusion
  type: table
  desc: Functions and constants for interacting with Photon Fusion

  members:
  - name: init
    type: function
    desc: |
      Initialize Fusion.
    parameters:
    - name: app_id
      type: string
    - name: app_version
      type: string

  - name: init_from_settings
    type: function
    desc: |
      Initialize Fusion from game.project settings.

  - name: connect
    type: function
    desc: |
      Connect Fusion.
    parameters:
    - name: user
      type: string
      optional: True
    - name: region
      type: string
      optional: True

  - name: disconnect
    type: function
    desc: |
      Disonnect Fusion.

  - name: reconnect
    type: function
    desc: |
      Reconnect Fusion.

  - name: start
    type: function
    desc: |
      Start Fusion sync.

  - name: stop
    type: function
    desc: |
      Stop Fusion sync.

  - name: get_state
    type: function
    desc: |
      Get connection state.
    returns:
    - name: Connection
      type: number
      desc: |
        State
        

  - name: get_disconnect_cause
    type: function
    desc: |
      Get disconnect cause.
    returns:
    - name: Disconnect
      type: number
      desc: |
        Cause
        

  - name: join_or_create_room_random
    type: function
    desc: |
      Join or create random room.
    parameters:
    - name: create_room_options
      type: table
    - name: matchmaking_options
      type: table

  - name: join_room_random
    type: function
    desc: |
      Join random room.
    parameters:
    - name: matchmaking_options
      type: table

  - name: join_room
    type: function
    desc: |
      Join room.
    parameters:
    - name: room_name
      type: string
    - name: join_room_options
      type: table

  - name: join_or_create_room
    type: function
    desc: |
      Join or create room.
    parameters:
    - name: room_name
      type: string
    - name: create_room_options
      type: table
    - name: join_room_options
      type: table

  - name: create_room
    type: function
    desc: |
      Create room.
    parameters:
    - name: room_name
      type: string
    - name: create_room_options
      type: table

  - name: leave_room
    type: function
    desc: |
      Leave room.
    parameters:
    - name: will_come_back
      type: boolean
    - name: send_auth_cookie
      type: boolean

  - name: is_connected
    type: function
    desc: |
      Check if Fusion is connected.
    returns:
    - name: connected
      type: boolean

  - name: is_running
    type: function
    desc: |
      Check if Fusion has config and is connected.
    returns:
    - name: running
      type: boolean

  - name: is_started
    type: function
    desc: |
      Check if Fusion is started. Fusion is considered started after a call to.
      `fusion.start()` has received a `EventOnFusionStart` event.
    returns:
    - name: started
      type: boolean

  - name: is_in_room
    type: function
    desc: |
      Check if Fusion is in a room.
    returns:
    - name: in_room
      type: boolean

  - name: enable_debug
    type: function
    desc: |
      Enable/disable debugging.
    parameters:
    - name: enable
      type: boolean

  - name: register_scene_object
    type: function
    desc: |
      Register a scene object.
    parameters:
    - name: scene
      type: number
    - name: factory_url
      type: string
    - name: owner_mode
      type: number
    - name: id
      type: string
      optional: True

  - name: spawn
    type: function
    desc: |
      Create a networked game object. This will spawn a game object in the same.
      Way as when calling factory.create(). The function will also register the spawned object with Fusion as if manually calling register_object()
    parameters:
    - name: factory_url
      type: string
    - name: position
      type: vector3
      desc: |
        Initial position of created game object
        
      optional: True
    - name: rotation
      type: quat
      desc: |
        Initial rotation of created game object
        
      optional: True
    - name: scene
      type: number
      desc: |
        The scene to which this object belongs
        
    - name: owner_mode
      type: number
      desc: |
        Owner mode of spawned object
        
    returns:
    - name: Id
      type: hash
      desc: |
        Of the spawned game object
        

  - name: despawn
    type: function
    desc: |
      Destroy a networked object.
    parameters:
    - name: id
      type: string
      optional: True

  - name: register_object
    type: function
    desc: |
      Register an object.
    parameters:
    - name: scene
      type: number
    - name: factory_url
      type: string
    - name: owner_mode
      type: number
    - name: id
      type: string
      optional: True

  - name: unregister_object
    type: function
    desc: |
      Unregister a previously registered object.
    parameters:
    - name: id
      type: string
      optional: True

  - name: change_scene
    type: function
    desc: |
      Change scene.
    parameters:
    - name: index
      type: number
    - name: sequence
      type: number
    - name: data
      type: string

  - name: rpc
    type: function
    desc: |
      Send RPC.
    parameters:
    - name: target_player
      type: number
      desc: |
        0 = all, specific PlayerId = targeted
        
    - name: data
      type: string
    returns:
    - name: ok
      type: boolean

  - name: on_event
    type: function
    desc: |
      Set event listener.
    parameters:
    - name: listener
      type: function

  - name: get_local_player_id
    type: function
    desc: |
      Get the player id of the local client
    returns:
    - name: The
      type: number
      desc: |
        Player id of the local client
        

  - name: get_owner_id
    type: function
    desc: |
      Get the player id of the current owner of an object
    parameters:
    - name: id
      type: string
      desc: |
        Id of the object to get the owner for
        
      optional: True
    returns:
    - name: The
      type: number
      desc: |
        Player id of the object's owner
        

  - name: has_authority
    type: function
    desc: |
      Check if this client has authority over a game object. Use this to decide if user input should be handled or not.
    parameters:
    - name: id
      type: string
      optional: True
    returns:
    - name: authority
      type: boolean
      desc: |
        Returns true if the client has authority
        

  - name: has_owner
    type: function
    desc: |
      Check if an object has an owner
    parameters:
    - name: id
      type: string
      desc: |
        Id of the object
        
      optional: True
    returns:
    - name: True
      type: boolean
      desc: |
        If the object has an owner
        

  - name: want_authority
    type: function
    desc: |
      Signal desire for the local client to own an object
    parameters:
    - name: claim_ownership
      type: boolean
    - name: id
      type: string
      desc: |
        Id of the object to own
        
      optional: True

  - name: clear_owner_cooldown
    type: function
    desc: |
      Explicitly clear the ownership cooldown
    parameters:
    - name: id
      type: string
      desc: |
        Id of the object to clear cooldown for
        
      optional: True

  - name: set_send_rate
    type: function
    desc: |
      Set the send rate of an object. This decided how much bandwidth to allocate
    parameters:
    - name: send_rate
      type: number
    - name: id
      type: string
      desc: |
        Id of the object to send rate for
        
      optional: True

  - name: set_local_send_rate
    type: function
    desc: |
      Set the local send rate divisor for an object. A value of `1` means the object sends every tick (highest rate). A value of `16` means it sends every 16th tick (lowest rate). This is a client-side optimization -- the object still exists on all clients but consumes less bandwidth when you are not the active authority.
    parameters:
    - name: send_rate
      type: number
    - name: id
      type: string
      desc: |
        Id of the object to send rate for
        
      optional: True

  - name: reset_send_rate
    type: function
    desc: |
      Reset the send rate of an object.
    parameters:
    - name: id
      type: string
      desc: |
        Id of the object to reset send rate for
        
      optional: True

  - name: player_count
    type: function
    desc: |
      Get player count
    returns:
    - name: count
      type: number
      desc: |
        Number of players
        

  - name: is_master_client
    type: function
    desc: |
      Get if this client is the room's master
    returns:
    - name: master
      type: boolean
      desc: |
        True if this client is the room's master
        

  - name: get_rtt
    type: function
    desc: |
      Get round trip time
    returns:
    - name: rtt
      type: number
      desc: |
        Round trip time in seconds
        

  - name: network_time_diff
    type: function
    desc: |
      Get raw offset between server time and local time. A positive value means the server clock is ahead of the local clock.
    returns:
    - name: diff
      type: number
      desc: |
        Time diff
        

  - name: set_global_interest_key
    type: function
    desc: |
      Set global visibility key for an object

  - name: set_area_interest_key
    type: function
    desc: |
      Set area visibility key for an object

  - name: set_user_interest_key
    type: function
    desc: |
      Set user visibility key for an object

  - name: set_area_keys
    type: function
    desc: |
      Set area visibility keys
    parameters:
    - name: keys
      type: table
      desc: |
        Area keys to set. Stored as a table of key value pairs (area_key->send_rate)
        

  - name: add_user_key
    type: function
    desc: |
      Add a user visibility key

  - name: remove_user_key
    type: function
    desc: |
      Remove a user visibility key from an object

  - name: OWNERMODE_TRANSACTION
    type: number
    desc: |
      OWNERMODE_TRANSACTION

  - name: OWNERMODE_PLAYERATTACHED
    type: number
    desc: |
      OWNERMODE_PLAYERATTACHED

  - name: OWNERMODE_DYNAMIC
    type: number
    desc: |
      OWNERMODE_DYNAMIC

  - name: OWNERMODE_MASTERCLIENT
    type: number
    desc: |
      OWNERMODE_MASTERCLIENT

  - name: OWNERMODE_GAMEGLOBAL
    type: number
    desc: |
      OWNERMODE_GAMEGLOBAL

  - name: STATE_DISCONNECTED
    type: number
    desc: |
      STATE_DISCONNECTED

  - name: STATE_CONNECTING
    type: number
    desc: |
      STATE_CONNECTING

  - name: STATE_CONNECTED
    type: number
    desc: |
      STATE_CONNECTED

  - name: STATE_JOININGROOM
    type: number
    desc: |
      STATE_JOININGROOM

  - name: STATE_INROOM
    type: number
    desc: |
      STATE_INROOM

  - name: STATE_LEAVINGROOM
    type: number
    desc: |
      STATE_LEAVINGROOM

  - name: STATE_DISCONNECTING
    type: number
    desc: |
      STATE_DISCONNECTING

  - name: DISCONNECT_CAUSE_NONE
    type: number
    desc: |
      DISCONNECT_CAUSE_NONE

  - name: DISCONNECT_CAUSE_DISCONNECTBYSERVERUSERLIMIT
    type: number
    desc: |
      DISCONNECT_CAUSE_DISCONNECTBYSERVERUSERLIMIT

  - name: DISCONNECT_CAUSE_EXCEPTIONONCONNECT
    type: number
    desc: |
      DISCONNECT_CAUSE_EXCEPTIONONCONNECT

  - name: DISCONNECT_CAUSE_DISCONNECTBYSERVER
    type: number
    desc: |
      DISCONNECT_CAUSE_DISCONNECTBYSERVER

  - name: DISCONNECT_CAUSE_DISCONNECTBYSERVERLOGIC
    type: number
    desc: |
      DISCONNECT_CAUSE_DISCONNECTBYSERVERLOGIC

  - name: DISCONNECT_CAUSE_TIMEOUTDISCONNECT
    type: number
    desc: |
      DISCONNECT_CAUSE_TIMEOUTDISCONNECT

  - name: DISCONNECT_CAUSE_EXCEPTION
    type: number
    desc: |
      DISCONNECT_CAUSE_EXCEPTION

  - name: DISCONNECT_CAUSE_INVALIDAUTHENTICATION
    type: number
    desc: |
      DISCONNECT_CAUSE_INVALIDAUTHENTICATION

  - name: DISCONNECT_CAUSE_MAXCCUREACHED
    type: number
    desc: |
      DISCONNECT_CAUSE_MAXCCUREACHED

  - name: DISCONNECT_CAUSE_INVALIDREGION
    type: number
    desc: |
      DISCONNECT_CAUSE_INVALIDREGION

  - name: DISCONNECT_CAUSE_OPERATIONNOTALLOWEDINCURRENTSTATE
    type: number
    desc: |
      DISCONNECT_CAUSE_OPERATIONNOTALLOWEDINCURRENTSTATE

  - name: DISCONNECT_CAUSE_CUSTOMAUTHENTICATIONFAILED
    type: number
    desc: |
      DISCONNECT_CAUSE_CUSTOMAUTHENTICATIONFAILED

  - name: DISCONNECT_CAUSE_CLIENTVERSIONTOOOLD
    type: number
    desc: |
      DISCONNECT_CAUSE_CLIENTVERSIONTOOOLD

  - name: DISCONNECT_CAUSE_CLIENTVERSIONINVALID
    type: number
    desc: |
      DISCONNECT_CAUSE_CLIENTVERSIONINVALID

  - name: DISCONNECT_CAUSE_DASHBOARDVERSIONINVALID
    type: number
    desc: |
      DISCONNECT_CAUSE_DASHBOARDVERSIONINVALID

  - name: DISCONNECT_CAUSE_AUTHENTICATIONTICKETEXPIRED
    type: number
    desc: |
      DISCONNECT_CAUSE_AUTHENTICATIONTICKETEXPIRED

  - name: DISCONNECT_CAUSE_DISCONNECTBYOPERATIONLIMIT
    type: number
    desc: |
      DISCONNECT_CAUSE_DISCONNECTBYOPERATIONLIMIT

  - name: EVENT_OBJECT_READY
    type: number
    desc: |
      EVENT_OBJECT_READY

  - name: EVENT_SUB_OBJECT_CREATED
    type: number
    desc: |
      EVENT_SUB_OBJECT_CREATED

  - name: EVENT_OBJECT_DESTROYED
    type: number
    desc: |
      EVENT_OBJECT_DESTROYED

  - name: EVENT_SUB_OBJECT_DESTROYED
    type: number
    desc: |
      EVENT_SUB_OBJECT_DESTROYED

  - name: EVENT_OBJECT_OWNER_CHANGED
