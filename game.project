[project]
title = PhotonFusion
version = 0.1
dependencies = 
write_log_file = 1
minimum_log_level = 0

[bootstrap]
main_collection = /example/example.collectionc

[input]
game_binding = /input/game.input_bindingc

[display]
width = 640
height = 1136

[script]
shared_state = 1

[library]
include_dirs = fusion

[render]
clear_color_red = 0.2
clear_color_green = 0.2
clear_color_blue = 0.2

[physics]
type = 3D
use_fixed_timestep = 1

[fusion]
app_id = 98c13f6b-d277-4a55-b9a9-24373e392d21

